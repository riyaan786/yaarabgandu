# ── Environment variables for YAARAB BATTERY AND TYRE WORKS documentation site ──
# Copy this file to `.env.local` and adjust the values. Never commit `.env.local`.

# Server-side only (NOT NEXT_PUBLIC_): the initial administrator access code.
# It is hashed (scrypt) and stored in the database on first run only.
# After first run, change the code from Admin Dashboard → Settings; this value is then ignored.
ADMIN_INITIAL_CODE=choose-a-strong-code

# Public site URL used for canonical URLs, sitemap, robots and Open Graph tags.
# Change this when you deploy publicly, e.g. https://example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONAL — only if you switch Search Console to the "HTML tag" method.
# Paste the full content= token that Search Console shows for the meta tag.
# The HTML-file method (public/googledc0c2b1b335e05db.html) needs nothing here.
GOOGLE_SITE_VERIFICATION=